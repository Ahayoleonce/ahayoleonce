# ============================================================
# AHAYO Leonce — Apache Configuration
# ============================================================

# --- Core options ---
Options -MultiViews -Indexes
DirectoryIndex index.html

# ============================================================
# 1) FORCE HTTPS + CANONICAL DOMAIN (non-www)
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Force non-www (remove leading www.)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# ============================================================
# 2) CLEAN URLS — remove .html extension
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 2a. External 301: /about.html -> /about
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2b. External 301: /about/ -> /about  (kill trailing slashes on clean URLs)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 2c. Internal rewrite: /about -> /about.html (200 OK)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ============================================================
# 3) SITEMAP & ROBOTS — correct MIME types
# ============================================================
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain    .txt
</IfModule>

<Files "sitemap.xml">
  ForceType application/xml
</Files>

<Files "robots.txt">
  ForceType text/plain
</Files>

# ============================================================
# 4) SECURITY HEADERS
# ============================================================
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy        "strict-origin-when-cross-origin"
  Header set X-Frame-Options        "SAMEORIGIN"
  Header set X-XSS-Protection       "1; mode=block"
  Header set Permissions-Policy     "geolocation=(), microphone=(), camera=()"
</IfModule>

# ============================================================
# 5) PROTECT SENSITIVE FILES
# ============================================================
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|inc|ini|log|orig|psd|sh|sql|sw[op])|~)$">
  Require all denied
</FilesMatch>

<Files ".htaccess">
  Require all denied
</Files>

# ============================================================
# 6) COMPRESSION (gzip)
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================================
# 7) CACHING
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML + XML: short cache (content changes; sitemap freshness)
  ExpiresByType text/html        "access plus 1 hour"
  ExpiresByType application/xml  "access plus 1 hour"

  # CSS / JS
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Images
  ExpiresByType image/png    "access plus 1 year"
  ExpiresByType image/jpeg   "access plus 1 year"
  ExpiresByType image/gif    "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp   "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff  "access plus 1 year"
  ExpiresByType font/ttf   "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# ============================================================
# 8) ERROR PAGES
# ============================================================
ErrorDocument 404 /404.html
# ErrorDocument 403 /403.html
# ErrorDocument 500 /500.html

# ============================================================
# 9) OPTIONAL — Block hotlinking (uncomment if needed)
# ============================================================
